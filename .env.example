# Optional build-time origin for sitemap.xml. No secrets are required.
# Set in your shell before building; no dotenv loader is installed.
SITE_ORIGIN=http://127.0.0.1:4173
# Empty for domain-root hosting; /Rusetat for a GitHub project site.
SITE_BASE_PATH=
# Explicit production publishing switch. Preview builds stay noindex by default.
# Public builds require an HTTPS origin and must not use the local example above.
SITE_INDEXABLE=false
